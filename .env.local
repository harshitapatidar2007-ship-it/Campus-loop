# CampusLoop Environment Configuration

# WhatsApp Cloud API Configuration
# Optional: Provide Meta WhatsApp Cloud API credentials to trigger automated server-side WhatsApp template/text alerts.
# If left blank, CampusLoop automatically falls back to direct browser WhatsApp (wa.me) links!
WHATSAPP_API_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Optional: Gemini API Key for CampusLoop Intelligence & AI Listing Assistant
# If left blank, CampusLoop automatically runs on its built-in NLP & semantic intent engine!
NEXT_PUBLIC_GEMINI_API_KEY=
GEMINI_API_KEY=

# Optional: Supabase PostgreSQL & Auth Credentials
# If left blank, CampusLoop automatically runs on its local, zero-config high-fidelity state engine!
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Application Environment
NODE_ENV=development
